// Windows resources: icon, manifest and version information.
#include <winver.h>

IDI_ICON1 ICON "@KADER_WIN_DIR@/kader.ico"
1 24 "@KADER_WIN_DIR@/kader.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Kader"
            VALUE "FileDescription",  "Kader"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "kader"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "kader.exe"
            VALUE "ProductName",      "Kader"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
